# cixcached configuration. Command-line flags override these.
#
# Copy to /opt/cixcache/etc/cixcache.conf, set a real push_token, and
# keep it mode 0640 -- it holds a credential.

# Where the store lives. Anything on one filesystem with the store is
# fine; blobs/, packages/ and tmp/ are created on first start. (There
# is no images/ -- that tier was removed in ADR-0006.)
root=/var/lib/cixcache

bind=0.0.0.0
port=8080
web_root=/opt/cixcache/share/web

# Pull may be open: consumers verify every byte against a checksum that
# comes from git, so an open pull surface gives an attacker nothing they
# could make a host accept. Push may not -- an open push lets anyone
# fill the disk, or plant blobs every puller then has to fetch and
# reject. Generate one with:
#
#     head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n'
#
pull_token=
push_token=CHANGE-ME

# Suffixes that may not be published unsigned, comma separated, matched
# with or without the leading dot. Empty means nothing is refused.
#
# The default is the historical behaviour and the one case that stands
# on its own: an ISO is booted, so nothing downstream gets a chance to
# check it. Adding .cixpkg or .tar.gz makes the store refuse unsigned
# packages too -- which will 409 a push from any Cix host whose signing
# key is not configured, and is why it is not the default. This is
# hygiene rather than security: the store is not a trust boundary
# (ADR-0002, ADR-0012).
require_signature=.iso

# A key this file does not mention keeps its built-in default. An empty
# value, though, is a value -- "require_signature=" enforces nothing.
